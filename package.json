{
  "name": "chat-tess",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "dev:worker": "tsx watch --env-file=.env src/worker/index.ts",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d postgres",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp-demo": "tsx --env-file=.env src/mcp-demo/server.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1165.0",
    "@googleapis/drive": "^27.0.0",
    "@googleapis/gmail": "^22.0.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@mozilla/readability": "^0.6.0",
    "ajv": "^8.20.0",
    "drizzle-orm": "^0.45.4",
    "google-auth-library": "^11.3.4",
    "ipaddr.js": "^2.5.0",
    "linkedom": "^0.18.15",
    "next": "^16.4.6",
    "openai": "^7.55.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.1",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "turndown": "^7.2.5",
    "undici": "^8.12.4",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
