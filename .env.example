# Postgres (docker compose expõe na 5433)
DATABASE_URL=postgres://tess:tess@localhost:5433/tess
TEST_DATABASE_URL=postgres://tess:tess@localhost:5433/tess_test

APP_URL=http://localhost:3000

# LLM: "fake" (determinístico, sem custo real) ou "openai"
LLM_PROVIDER=fake
OPENAI_API_KEY=
# Modelo e preços NÃO são fixados no código: confirmar na conta e na página oficial de preços.
OPENAI_MODEL=
# micro-USD por 1M tokens, ex.: {"version":"2026-11-10","input":0,"cachedInput":0,"output":0}
OPENAI_PRICING_JSON=
MAX_OUTPUT_TOKENS=2048

# Google login (somente identidade neste bloco)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Créditos em micro-USD (1 crédito = 1000 micro-USD = US$ 0,001)
CREDITS_USER_LIMIT_MICRO=2000000
CREDITS_DEMO_LIMIT_MICRO=200000
CREDITS_GLOBAL_LIMIT_MICRO=20000000
DEMO_MAX_SESSIONS_PER_HOUR=30
TURNS_PER_MINUTE=10

# Atraso por token do provider fake (ms), útil para testar reconexão
FAKE_LLM_DELAY_MS=40

# Criptografia de tokens e secrets (32 bytes base64): node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Busca nativa: tarifa por chamada (micro-USD) conforme página oficial; sem valor, a busca fica indisponível.
OPENAI_WEB_SEARCH_FEE_MICRO=
WEB_SEARCH_MAX_CALLS=1
MAX_ITERATIONS=6
MAX_TOOL_CALLS=12

# Exceções do SSRF guard apenas para desenvolvimento local (host:porta). Vazio em produção.
SSRF_ALLOW_HOSTS=localhost:3100

# Servidor MCP de demonstração (npm run mcp-demo)
MCP_DEMO_PORT=3100
MCP_DEMO_TOKEN=

# Storage: sem R2 usa disco local (somente dev). Em produção, R2 é obrigatório.
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
OPENAI_REASONING_EFFORT=low
WEB_SEARCH_TOKENS_PER_CALL=10000

# Compactação: gatilho em tokens estimados; visitantes demo usam um gatilho menor.
COMPACTION_TRIGGER_TOKENS=60000
DEMO_COMPACTION_TRIGGER_TOKENS=2500
COMPACTION_KEEP_TURNS=2

# E-mails Google com papel admin (separados por vírgula)
ADMIN_EMAILS=
